void autonomous() {
    chassis.setPose(0, 0, 0);
    chassis.moveToPoint(0, -20, 2000, {.forwards = false}, false);
    DoubleBar.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
    DoubleBar.move(45);
    pros::delay(2000);
    DoubleBar.brake();
    chassis.moveToPoint(0, 3, 1000, {.maxSpeed = 75, .minSpeed =45});
    chassis.moveToPoint(0, -10, 1000, {.forwards = false});
    chassis.moveToPoint(0, 3, 1000, {.maxSpeed = 75, .minSpeed = 45});
    chassis.moveToPoint(0, -20, 1000, {.forwards = false}, false);
    DoubleBar.set_brake_mode(pros::E_MOTOR_BRAKE_COAST);
    DoubleBar.move(-45);

    pros::delay(1000);
    DoubleBar.move(0);
}

void opcontrol() {
    chassis.cancelAllMotions();
    chassis.setPose(0, 0, 0);
    bool held = false;
    
    const double LEVELING_GAIN = .9;
    const double CLAW_KP = 0.4;
    const double CLAW_KD = 0.1; 
    double claw_last_error = 0; 

    while (true) {
        int dir = master.get_analog(ANALOG_LEFT_Y);
        int turn = master.get_analog(ANALOG_RIGHT_X);

        right_mg.move(dir + turn);
        left_mg.move(dir - turn);


        if (master.get_digital_new_press(DIGITAL_X)) {
            pros::Task macro_task([](void* param) {
                execute_macro_logic();
            }, nullptr, "X Macro");
        }


        if (master.get_digital_new_press(DIGITAL_R2)) {
            auton_lift_active = false; 
            pros::delay(20);
            MoveArmLevelBackground(1200.0, 80);
        }


        if (master.get_digital_new_press(DIGITAL_L1) && !is_l1_macro_running) {
            is_l1_macro_running = true; 
            auton_lift_active = false; 
            lift_is_holding = false; 

            pros::Task l1_sequence_task([]() {
                CascadeUp.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
                pros::delay(20);
                
                DoubleBarMove(0, 100, 1000);

                CascadeMove(6000, 200, 2000);

                CascadeUp.brake();

                lift_is_holding = false; 
                is_l1_macro_running = false; 
            });
        }

        if (master.get_digital_new_press(DIGITAL_R1)) {
            if (claw == false) {
                
                air.set_value(true);
                pros::delay(20);
                claw = true;
                if (CascadeUp.get_position() < 1250);
                    is_cascade_moving_bg = true;
                    pros::Task cascade_bg_task([]() {
                    CascadeMove(0, 200, 1000);
                    is_cascade_moving_bg = false;
                });
            } else {
                air.set_value(false);
                pros::delay(20);
                claw = false;
                if (CascadeUp.get_position() < 50);
                    is_cascade_moving_bg = true;
                    pros::Task cascade_bg_task([]() {
                    CascadeMove(750, 200, 1000);
                    is_cascade_moving_bg = false;
                });
            } 
        }


        if (!macro_is_running) {
            double lift_motor_ticks = DoubleBar.get_position();
            
            double claw_target_ticks = -lift_motor_ticks * 0.3 * LEVELING_GAIN;

            double claw_error = claw_target_ticks - ClawArm.get_position();
            double claw_derivative = claw_error - claw_last_error;
            claw_last_error = claw_error; 
            double claw_power = (claw_error * CLAW_KP) + (claw_derivative * CLAW_KD);

            // Always track claw leveling
            ClawArm.move(claw_power); 

            if (master.get_digital(DIGITAL_Y)) {
                auton_lift_active = false; 
                lift_is_holding = false; 
                DoubleBar.move(50); 
            } 
            
            else if (master.get_digital(DIGITAL_RIGHT)) {
                auton_lift_active = false; 
                lift_is_holding = false; 
                DoubleBar.move(-50); 
            }

            else if (master.get_digital_new_press(DIGITAL_L2) && !is_cascade_moving_bg) {
                is_cascade_moving_bg = true;

                pros::Task cascade_bg_task([](void* param) {
                    CascadeMove(0, 200, 2000); 
                    
                    is_cascade_moving_bg = false; 
                }, nullptr, "L2 Cascade Task");
            }
            else if (master.get_digital(DIGITAL_UP)) {
                auton_lift_active = false;
                CascadeUp.move(127);
            }
            else if (master.get_digital(DIGITAL_DOWN)) {
                auton_lift_active = false;
                CascadeUp.move(-127);
            }

            else if (!auton_lift_active && !is_l1_macro_running) {
                if (lift_is_holding == false) {
                    lift_target_pos = DoubleBar.get_position();
                    lift_last_error = 0;                        
                    lift_is_holding = true;                     
                }

                if (!is_cascade_moving_bg) {
                    if (!master.get_digital(DIGITAL_UP) && !master.get_digital(DIGITAL_DOWN)) {
                        CascadeUp.move(0);
                        CascadeUp.brake();
                    }
                }

                LiftBrake();
                IntakeAndOuttake.move(0);
            }
            else {
                IntakeAndOuttake.move(0);
            }
        }
        else {
            IntakeAndOuttake.move(0);
        }

        pros::delay(20);
    }
}
