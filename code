}

// Constants for your claw setup
const double CLAW_GEAR_RATIO = 4.722; 
const double CLAW_GEAR_RATIO2 = 1.5; 
const double CLAW_CLEARANCE = 5.0 * CLAW_GEAR_RATIO; 
const double CLAW_CLEARANCE2 = 5.0 * CLAW_GEAR_RATIO2; 
const double hold_kP = 1; 

void ClawMove(double target_claw_angle, int speed, int timeout_ms) {
    double motor_target = target_claw_angle * CLAW_GEAR_RATIO; 
    ClawArm.move_absolute(motor_target, speed);
    
    Timer claw_wait(timeout_ms); 
    while (claw_wait.is_running()) {
        double current_motor_pos = ClawArm.get_position();
        double error = std::abs(motor_target - current_motor_pos);
        if (error <= (12.0 * CLAW_GEAR_RATIO)) { 
            break; 
        }
        pros::delay(20); 
    }   
    ClawArm.move(0);
    ClawArm.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
}

void CascadeMove(double target_cascade_move, int speed, int timeout_ms) {
    double motor_target = target_cascade_move; 
    CascadeUp.move_absolute(motor_target, speed);
    
    Timer claw_wait(timeout_ms); 
    while (claw_wait.is_running()) {
        double current_motor_pos = CascadeUp.get_position();
        double error = std::abs(motor_target - current_motor_pos);
        if (error <= 15.0) { 
            break; 
        }
        pros::delay(20); 
    }   
    CascadeUp.move(0);
    CascadeUp.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
}

