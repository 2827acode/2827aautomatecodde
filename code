void execute_macro_logic() {
    macro_is_running = true; 
    clawArmStallDone = false;
    air.set_value(false);
    pros::delay(20);
    claw = false;

    // 1. Launch the claw stall helper at speed 50 to prevent over-current drops
    CascadeUp.set_brake_mode(pros::E_MOTOR_BRAKE_COAST);
    CascadeUp.brake();
    CascadeMove(0, 200, 2000);
    CascadeUp.brake();
    pros::Task claw_task(claw_arm_task_wrapper, (void*)50, "ClawArm Task");

    // 2. Start moving the lift down
    move_until_stalled_DoubleBar(-45);

    // 3. Safety Timeout Loop (Max 2.5 seconds)
    int timeout_counter = 0;
    while (!clawArmStallDone && timeout_counter < 250) {
        pros::delay(10);
        timeout_counter++;
    }

    // 4. Reset positions
    ClawArm.tare_position();
    DoubleBar.tare_position();
    pros::delay(20);

    // 5. Move to driver layout zero (-100)
    ClawMove(-95, 50, 1000); 
    ClawArm.tare_position();
    air.set_value(true);
    pros::delay(20);
    claw = true;

    lift_is_holding = false;

    // 6. Release control back to driver controls safely
    macro_is_running = false; 
}

void background_lift_task(void* param) {
    const double LEVELING_GAIN = 1.1; 
    const double CLAW_KP = 0.4;       
    const double CLAW_KD = 0.1; 
    double claw_last_error = 0;

    uint32_t start_time = pros::millis();
    const uint32_t MAX_RUN_TIME_MS = 3000; 

    int stall_counter = 0;

    while (auton_lift_active) {
        if ((pros::millis() - start_time) > MAX_RUN_TIME_MS) {
            break;
        }

        double lift_motor_ticks = DoubleBar.get_position();
        double lift_error = auton_lift_target - lift_motor_ticks;

        if (std::abs(lift_error) < 15) {
            break;
        }

        // Mechanical Hard-Stop Stall Protection
        if (std::abs(DoubleBar.get_actual_velocity()) < 5 && std::abs(lift_error) > 20) {
            stall_counter++;
        } else {
            stall_counter = 0;
        }

        if (stall_counter > 5) {
            break;
        }

        double lift_power = lift_error * 0.4;
        if (lift_power > auton_lift_max_velocity) lift_power = auton_lift_max_velocity;
        if (lift_power < -auton_lift_max_velocity) lift_power = -auton_lift_max_velocity;
        DoubleBar.move(lift_power);

        // CLEAN LINEAR LEVEL TRACKING
        double claw_target_ticks = -lift_motor_ticks * 0.3 * LEVELING_GAIN;

        double claw_error = claw_target_ticks - ClawArm.get_position();
        double claw_derivative = claw_error - claw_last_error;
        claw_last_error = claw_error; 
        double claw_power = (claw_error * CLAW_KP) + (claw_derivative * CLAW_KD);
        ClawArm.move(claw_power);

        pros::delay(20);
    }
    
    DoubleBar.move(0); 
    auton_lift_active = false; 
    lift_is_holding = false; 
}

void MoveArmLevelBackground(double target_angle, int velocity) {
    auton_lift_target = target_angle;
    auton_lift_max_velocity = velocity;
    lift_is_holding = false;

    if (!auton_lift_active) {
        auton_lift_active = true;
        pros::Task lift_bg_thread(background_lift_task, nullptr, "Bg Lift Task");
    }
}

