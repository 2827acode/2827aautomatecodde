class Timer {
private:
    uint32_t start_time;
    uint32_t duration;

public:
    Timer(uint32_t wait_time_ms) {
        start_time = pros::millis();
        duration = wait_time_ms;
    }

    bool is_running() {
        return (pros::millis() - start_time) < duration;
    }
};

const double kp = 1;
void pid_brake_lift() {
    double target = DoubleBar.get_position();
    while (true) {
        double error = target - DoubleBar.get_position();
        DoubleBar.move(error * kp);
        pros::delay(20);
    }
}

const double LIFT_KP = .1;  // Core muscle strength
const double LIFT_KD = 1;   // Dampening to prevent bouncing/shaking

double lift_target_pos = 0;
double lift_last_error = 0;
bool lift_is_holding = false;
bool should_hold_lift = false;
double lift_hold_target = 0;

void LiftBrake() {
    if (!lift_is_holding) {
        lift_target_pos = DoubleBar.get_position();
        lift_last_error = 0; 
        lift_is_holding = true;
    }

    double current_pos = DoubleBar.get_position();
    double error = lift_target_pos - current_pos;
    double derivative = error - lift_last_error;
    lift_last_error = error; 

    double total_voltage = (error * LIFT_KP) + (derivative * LIFT_KD);

    if (total_voltage > 70) total_voltage = 70;
    if (total_voltage < -70) total_voltage = -70;

    DoubleBar.move(total_voltage);
}

void lift_hold_task_fn(void* param) {
    const double kp = 1.0; 
    while (true) {
        if (should_hold_lift) {
            double error = lift_hold_target - DoubleBar.get_position();
            DoubleBar.move(error * kp);
        }
        pros::delay(20); 
    }
}

void move_until_stalled_ClawArm(int velocity) {
    ClawArm.move(velocity);
    Timer timer(1000); 
    int stall_counter = 0;

    while (timer.is_running()) {
        double actual_velocity = ClawArm.get_actual_velocity();
        int current_draw = ClawArm.get_current_draw();

        if (std::abs(actual_velocity) < 10 && current_draw > 1000) { 
            stall_counter++;
        } else {
            stall_counter = 0;
        }

        if (stall_counter > 5) {
            break;
        }

        pros::delay(20);
    }
    ClawArm.brake();
    clawArmStallDone = true;
}

void claw_arm_task_wrapper(void* param) {
    int speed = (int)(intptr_t)param;
    move_until_stalled_ClawArm(speed);
}

void move_until_stalled_DoubleBar(int velocity) {
